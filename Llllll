-- ลูปการทำงานระบบ HeadLock และ ESP
RunService.RenderStepped:Connect(function()
    for player, esp in pairs(espStorage) do
        local char = player.Character
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        local rootPart = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head"))
        
        if char and humanoid and rootPart and humanoid.Health > 0 then
            local vector, onScreen = Camera:WorldToViewportPoint(rootPart.Position + Vector3.new(0, 2.5, 0))
            
            if onScreen then
                if Settings.ESPName then
                    esp.NameTag.Text = player.DisplayName .. " (@" .. player.Name .. ")"
                    esp.NameTag.Position = UDim2.new(0, vector.X - 75, 0, vector.Y - 20)
                    esp.NameTag.Visible = true
                else
                    esp.NameTag.Visible = false
                end
                
                if Settings.ESPHealth then
                    local healthPercent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                    esp.HealthBar.Size = UDim2.new(healthPercent, 0, 1, 0)
                    esp.HealthBarBg.Position = UDim2.new(0, vector.X - 15, 0, vector.Y)
                    esp.HealthBarBg.Visible = true
                else
                    esp.HealthBarBg.Visible = false
                end
            else
                esp.NameTag.Visible = false
                esp.HealthBarBg.Visible = false
            end
        else
            esp.NameTag.Visible = false
            esp.HealthBarBg.Visible = false
        end
    end

    if Settings.Enabled then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                if not Settings.TeamCheck or (player.Team ~= LocalPlayer.Team or player.Team == nil) then
                    local character = player.Character
                    if character and character:FindFirstChild("Head") and character:FindFirstChildOfClass("Humanoid") then
                        if character.Humanoid.Health > 0 then
                            Camera.CFrame = CFrame.new(Camera.CFrame.Position, character.Head.Position)
                            break
                        end
                    end
                end
            end
        end
    end
end)

