-- ==================== 3. SMALLER ESP SYSTEM ====================
local espStorage = {}

local function createESP(player)
    if player == LocalPlayer then return end
    
    local espFolder = Instance.new("Folder")
    espFolder.Name = "ESP_" .. player.Name
    espFolder.Parent = ScreenGui
    
    local nameTag = Instance.new("TextLabel")
    nameTag.Parent = espFolder
    nameTag.Size = UDim2.new(0, 150, 0, 16)
    nameTag.BackgroundTransparency = 1
    nameTag.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameTag.TextStrokeTransparency = 0
    nameTag.Font = Enum.Font.SourceSansBold
    nameTag.TextSize = 10
    nameTag.Visible = false
    
    local healthBarBg = Instance.new("Frame")
    healthBarBg.Parent = espFolder
    healthBarBg.Size = UDim2.new(0, 30, 0, 3)
    healthBarBg.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    healthBarBg.BorderSizePixel = 0
    healthBarBg.Visible = false
    
    local healthBar = Instance.new("Frame")
    healthBar.Parent = healthBarBg
    healthBar.Size = UDim2.new(1, 0, 1, 0)
    healthBar.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
    healthBar.BorderSizePixel = 0
    
    espStorage[player] = {
        Folder = espFolder,
        NameTag = nameTag,
        HealthBarBg = healthBarBg,
        HealthBar = healthBar
    }
end

local function removeESP(player)
    if espStorage[player] then
        espStorage[player].Folder:Destroy()
        espStorage[player] = nil
    end
end

for _, p in pairs(Players:GetPlayers()) do createESP(p) end
Players.PlayerAdded:Connect(createESP)
Players.PlayerRemoving:Connect(removeESP)

-- ฟังก์ชันย้ายเซิฟเวอร์
local function hopServer(regionCode)
    ServerSGBtn.Text = "⏳ กำลังค้นหาเซิฟเวอร์..."
    ServerMEBtn.Text = "⏳ กำลังค้นหาเซิฟเวอร์..."
    
    pcall(function()
        local servers = {}
        local cursor = ""
        
        repeat
            local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
            if cursor ~= "" then url = url .. "&cursor=" .. cursor end
            local success, result = pcall(function() return HttpService:JSONDecode(game:HttpGet(url)) end)
            
            if success and result and result.data then
                for _, s in ipairs(result.data) do
                    if s.playing and s.maxPlayers and s.playing < s.maxPlayers and s.id ~= game.JobId then
                        local pingStr = tostring(s.ping or ""):lower()
                        local nameStr = tostring(s.name or ""):lower()
                        if regionCode == "SG" then
                            if pingStr:find("sg") or pingStr:find("singapore") or nameStr:find("singapore") or (s.ping and s.ping < 80) then
                                table.insert(servers, s.id)
                            end
                        elseif regionCode == "ME" then
                            if pingStr:find("ae") or pingStr:find("dubai") or pingStr:find("middle east") or pingStr:find("bahrain") then
                                table.insert(servers, s.id)
                            end
                        end
                    end
                end
                cursor = result.nextPageCursor
            else
                break
            end
        until cursor == nil or #servers > 0

        if #servers == 0 then
            local urlFallback = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
            local success, result = pcall(function() return HttpService:JSONDecode(game:HttpGet(urlFallback)) end)
            if success and result and result.data then
                for _, s in ipairs(result.data) do
                    if s.playing and s.maxPlayers and s.playing < s.maxPlayers and s.id ~= game.JobId then
                        table.insert(servers, s.id)
                    end
                end
            end
        end

        if #servers > 0 then
            TeleportService:TeleportToPlaceInstance(game.PlaceId, servers[math.random(1, #servers)], LocalPlayer)
        else
            TeleportService:Teleport(game.PlaceId, LocalPlayer)
        end
    end)
end

