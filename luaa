-- ลูปการทำงานระบบล็อกหัว
RunService.RenderStepped:Connect(function()
    FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    FOVCircle.Visible = showFovUI and Settings.Enabled

    if Settings.Enabled then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                if not Settings.TeamCheck or (player.Team ~= LocalPlayer.Team or player.Team == nil) then
                    local character = player.Character
                    if character and character:FindFirstChild("Head") and character:FindFirstChildOfClass("Humanoid") then
                        if character.Humanoid.Health > 0 then
                            Camera.CFrame = CFrame.new(Camera.CFrame.Position, character.Head.Position)
                            break
                        end
                    end
                end
            end
        end
    end
end)

